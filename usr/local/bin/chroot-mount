#!/bin/bash
set -euo pipefail
die() { echo "Error: $*" >&2; exit 1; }

help() {
  cat << EOF
Mount/unmount filesystems for chroot
Usage:
  chroot-mount    <dir>   Mount proc/sys/dev and enter chroot (default)
  chroot-mount -m <dir>   Mount only (without entering chroot)
  chroot-mount -u <dir>   Unmount proc/sys/dev

Examples:
  chroot-mount /mnt/gentoo
  chroot-mount -m /mnt/gentoo
  chroot-mount -u /mnt/gentoo
EOF
}

( [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ] ) && help && exit 1

MODE="enter"
if [ "$1" = "-m" ]; then
  MODE="mount"
  shift
elif [ "$1" = "-u" ]; then
  MODE="umount"
  shift
fi

[ $# -eq 0 ] && { help; die "provide chroot directory"; }
DIR=$1

[ ! -d "$DIR" ] && die "directory '$DIR' does not exist"

case $MODE in
  mount|enter)
    mount --types proc /proc "$DIR/proc"
    mount --rbind /sys "$DIR/sys"
    mount --make-rslave "$DIR/sys"
    mount --rbind /dev "$DIR/dev"
    mount --make-rslave "$DIR/dev"
    [ "$MODE" = "enter" ] && chroot "$DIR" || true
    ;;
  umount)
    # Try all three trees even if one fails, then diagnose the holdouts:
    # fuser/lsof name the processes keeping the mount busy (usually a shell
    # still chrooted in, or a daemon started inside the chroot).
    failed=()
    for sub in dev sys proc; do
      mountpoint -q "$DIR/$sub" || continue
      umount -R "$DIR/$sub" || failed+=("$DIR/$sub")
    done
    if [ "${#failed[@]}" -gt 0 ]; then
      for m in "${failed[@]}"; do
        echo "--- still mounted: $m — processes holding it:" >&2
        if command -v fuser > /dev/null; then
          fuser -vm "$m" >&2 || echo "(fuser: no process found — try again, or a submount is the holder)" >&2
        fi
        if command -v lsof > /dev/null; then
          lsof +f -- "$m" >&2 || true
        fi
      done
      die "could not unmount: ${failed[*]}"
    fi
    echo "Unmounted $DIR"
    ;;
esac
