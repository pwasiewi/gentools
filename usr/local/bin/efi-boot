#!/bin/bash
# efi-boot — Gentoo UEFI boot method installer
#
# Requires keys generated by efi-keys in WORKDIR/keys/.
# Run AFTER enrolling keys to UEFI (via BIOS or efi-keys --enroll).
#
# ---------------------------------------------------------------------------
# Security ranking — most to least secure
# Column "Key wipe" = what happens when Secure Boot keys are cleared in BIOS
# ---------------------------------------------------------------------------
#
#   [1] stub-signed / stub  +  own PK/KEK/db
#         Chain:     UEFI firmware → own db → signed kernel  (no bootloader)
#         Key wipe:  nothing boots — full lockout, maximum isolation
#         Surface:   firmware only; no bootloader code executes before kernel
#
#   [2] grub  +  own PK/KEK/db
#         Chain:     UEFI firmware → own db → signed GRUB → kernel
#         Key wipe:  nothing boots — same lockout as [1]
#         Surface:   GRUB code executes before kernel (slightly larger than [1])
#
#   [3] shim  +  MOK  (MS PK/KEK retained, no own PK)
#         Chain:     UEFI → MS PK → MS db → shim (MS-signed) → MOK → GRUB → kernel
#         Key wipe (MOK only):    Gentoo blocked, Windows unaffected
#         Key wipe (MS db reset): shim fails — everything including Windows fails
#         Dual-boot safe: does not touch PK/KEK; MOK managed from OS via mokutil
#         Risk: shim is a large trusted binary; MOK enrolled from OS, not firmware
#
#   [4] stub-signed / grub  +  db append only  (MS PK/KEK retained, no own PK)
#         Chain:     UEFI → MS PK → MS KEK → db (MS + own appended) → kernel/GRUB
#         Key wipe:  own db entry removed → kernel not MS-signed → does not boot
#         Weakest:   fully dependent on MS infrastructure
#         When to use: BIOS does not support Setup Mode (e.g. ThinkPad Deployed Mode)
#           BIOS → Security → Secure Boot → Key Management → db → Append → db.cer
#
# ---------------------------------------------------------------------------
# Methods (listed in security order):
#   stub-signed  EFI Stub: sign-only, kernel with built-in initramfs  [rank 1, confirmed working]
#   stub-luks    EFI Stub: sign-only + LUKS2 cmdline via efibootmgr   [rank 1, encrypted root]
#   stub         UKI: kernel + initrd + cmdline in one signed PE       [rank 1, needs systemd-stub]
#   grub         GRUB standalone signed with db key, no shim          [rank 2]
#   shim         GRUB signed with MOK, shim as chain validator         [rank 3]
#   shell        EFI Shell entry (diagnostic, runs unsigned)
#   all          All of the above
#
# Usage:
#   sudo efi-boot --disk /dev/sdX [options]
#
# Options:
#   --disk     /dev/nvme0n1       target disk for efibootmgr (REQUIRED — no
#                                 default, so the wrong disk is never assumed)
#   --part     1                  ESP partition number (default: 1)
#   --method   stub-signed        boot method (default: all)
#   --esp      /boot/efi          ESP mount point (default: /boot/efi)
#   --name     NAME               stub methods only: install under EFI/NAME and
#                                 suffix the boot label with (NAME) — lets one
#                                 ESP hold several stub entries for different
#                                 disks / mounted /mnt/gentoo installs
#                                 (default: EFI/GentooEFISTUB, plain label)
#   --root     PART|UUID=...      root device for the kernel cmdline (default:
#                                 the RUNNING system's root — pass this when
#                                 the stub is for another disk's install)
#   --kernel   /boot/kernel-...   kernel path (auto-detected if omitted)
#   --initrd   /boot/initramfs-.. initrd path (auto-detected, optional for stub-signed)
#   --cmdline  "ro quiet splash"  kernel command line appended to CONFIG_CMDLINE
#   --workdir  ~/secureboot       must match path used in efi-keys
#   --luks-uuid UUID              LUKS2 UUID for stub-luks method (auto-detected if omitted)

set -euo pipefail

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
DISK=""                      # REQUIRED — no default on purpose (see --disk)
PARTITION="1"
METHOD="all"
ESP="/boot/efi"
WORKDIR="$HOME/secureboot"
KERNEL=""
INITRD=""
CMDLINE_EXTRA="ro quiet splash"
LUKS_UUID=""
NAME=""                      # optional stub entry name (EFI dir + label suffix)
ROOT_ARG=""                  # optional root device/UUID for the cmdline

GRUB_MODULES_FULL="part_gpt part_msdos ext2 fat configfile normal linux multiboot \
efi_gop efi_uga all_video gfxterm font efi_signature verifiers lockdown"
GRUB_MODULES_SHIM="part_gpt part_msdos ext2 fat configfile normal linux \
efi_gop efi_uga all_video gfxterm font"

# ---------------------------------------------------------------------------
# CLI parsing
# ---------------------------------------------------------------------------
usage() { cat << 'EOF'
Usage: sudo efi-boot --disk /dev/sdX [options]

Options:
  --disk     /dev/nvme0n1       target disk for efibootmgr (REQUIRED)
  --part     1                  ESP partition number (default: 1)
  --method   stub-signed        boot method (default: all)
  --esp      /boot/efi          ESP mount point (default: /boot/efi)
  --name     NAME               stub methods: EFI/NAME dir + "(NAME)" label
                                suffix — several stub entries can coexist
                                (default: EFI/GentooEFISTUB, plain label)
  --root     PART|UUID=...      root device for the cmdline (default: the
                                RUNNING system's root — set for other disks)
  --kernel   /boot/kernel-...   kernel path (auto-detected if omitted)
  --initrd   /boot/initramfs-.. initrd path (auto-detected, optional for stub-signed)
  --cmdline  "ro quiet splash"  kernel cmdline appended to CONFIG_CMDLINE
  --workdir  ~/secureboot       must match path used in efi-keys
  --luks-uuid UUID              LUKS2 UUID for stub-luks (auto-detected if omitted)
  -h, --help                    show this help

Methods (security rank, best first):
  stub-signed  sign kernel only, cmdline via efibootmgr NVRAM      [rank 1, recommended]
  stub-luks    stub-signed + LUKS2 rd.luks.uuid in cmdline         [rank 1, encrypted root]
  stub         UKI: kernel + initrd + cmdline, one signed PE        [rank 1, needs systemd-stub]
  grub         GRUB standalone signed with db key, no shim         [rank 2]
  shim         GRUB signed with MOK, shim as chain validator        [rank 3]
  shell        EFI Shell entry (diagnostic, unsigned)
  all          all of the above

Early microcode: intel-uc.img / amd-uc.img sitting next to the kernel are
picked up automatically — stub methods prepend initrd=\EFI\...\ entries to
the NVRAM cmdline, the UKI gets them glued in front of its .initrd section.
(grub/shim read the host's grub.cfg, where grub-mkconfig adds them itself.)

Examples:
  sudo efi-boot --disk /dev/nvme0n1 --method stub-signed
  sudo efi-boot --disk /dev/nvme0n1 --method stub-luks --luks-uuid 1234abcd-...
  sudo efi-boot --disk /dev/sda --method grub --part 1

  # Second stub for another install mounted at /mnt/gentoo, on its own disk:
  # entry "Gentoo EFI Stub (sdb-gentoo)" loading EFI/sdb-gentoo/vmlinuz-signed.efi
  sudo efi-boot --disk /dev/sdb --method stub-signed --name sdb-gentoo \
       --root /dev/sdb3 --kernel /mnt/gentoo/boot/kernel-6.12.4

Multi-entry traps (learned the hard way):
  - An entry for ANOTHER install needs --root, or its cmdline embeds the
    RUNNING system's root UUID and the entry boots the wrong system.
  - Some firmwares prune all but one NVRAM entry pointing into the SAME ESP
    partition at reboot (the signed kernels survive on the ESP). If your
    named entry vanishes: put the second system's stub on its own disk's ESP
    (--disk/--esp), boot it via the firmware's "Boot from file" browser, or
    use one boot manager entry that lists both kernels.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --disk)      DISK="$2";         shift 2 ;;
        --part)      PARTITION="$2";    shift 2 ;;
        --method)    METHOD="$2";       shift 2 ;;
        --esp)       ESP="$2";          shift 2 ;;
        --kernel)    KERNEL="$2";       shift 2 ;;
        --initrd)    INITRD="$2";       shift 2 ;;
        --cmdline)   CMDLINE_EXTRA="$2"; shift 2 ;;
        --workdir)   WORKDIR="$2";      shift 2 ;;
        --luks-uuid) LUKS_UUID="$2";   shift 2 ;;
        --name)      NAME="$2";        shift 2 ;;
        --root)      ROOT_ARG="$2";    shift 2 ;;
        -h|--help)   usage; exit 0 ;;
        *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
die()     { echo "❌  $*" >&2; exit 1; }
info()    { echo ">>>  $*"; }
ok()      { echo "✅  $*"; }
warn()    { echo "⚠️   $*"; }
need_cmd(){ command -v "$1" &>/dev/null || die "Missing tool: $1"; }

[[ $EUID -eq 0 ]] || die "Root required: sudo $0"

# --disk is deliberately mandatory: a silent /dev/nvme0n1 default writes NVRAM
# entries for a disk the user may not have meant at all.
[[ -n "$DISK" ]] || { usage >&2; die "--disk is required (e.g. --disk /dev/nvme0n1)"; }
[[ -b "$DISK" ]] || die "Not a block device: $DISK"

# --name feeds a FAT directory name and an efibootmgr label — keep it to
# characters safe for both (no spaces, slashes, backslashes).
if [[ -n "$NAME" ]]; then
    [[ "$NAME" =~ ^[A-Za-z0-9._-]+$ ]] \
        || die "--name may only contain letters, digits, dot, dash, underscore: $NAME"
fi

# ---------------------------------------------------------------------------
# Dependency check per method
# ---------------------------------------------------------------------------
need_cmd sbsign
need_cmd sbverify
need_cmd efibootmgr

case "$METHOD" in
    all|grub|shim) need_cmd grub-mkstandalone ;;
esac
case "$METHOD" in
    all|stub) need_cmd objcopy ;;
esac
case "$METHOD" in
    all|shim)
        need_cmd mokutil
        [[ -f /usr/share/shim/BOOTX64.EFI ]] \
            || die "Missing /usr/share/shim/BOOTX64.EFI — install the shim-signed package"
        [[ -f /usr/share/shim/mmx64.efi ]] \
            || die "Missing /usr/share/shim/mmx64.efi"
        ;;
esac

# ---------------------------------------------------------------------------
# Key directory check
# ---------------------------------------------------------------------------
KEYDIR="$WORKDIR/keys"
[[ -f "$KEYDIR/db.key" && -f "$KEYDIR/db.crt" ]] \
    || die "No keys found in $KEYDIR — run first: sudo efi-keys"
[[ -f "$KEYDIR/MOK.key" && -f "$KEYDIR/MOK.crt" ]] \
    || die "No MOK found in $KEYDIR — re-run efi-keys"

# ---------------------------------------------------------------------------
# Auto-detect kernel
# ---------------------------------------------------------------------------
if [[ -z "$KERNEL" ]]; then
    KERNEL=$(ls -t /boot/kernel-* /boot/vmlinuz-* 2>/dev/null | head -1 || true)
    [[ -n "$KERNEL" ]] || die "No kernel found in /boot — use --kernel"
    warn "Auto-detected kernel: $KERNEL"
fi
[[ -f "$KERNEL" ]] || die "Kernel does not exist: $KERNEL"

# ---------------------------------------------------------------------------
# Auto-detect initrd — only for methods that embed one. stub-signed and
# stub-luks are used with built-in-initramfs kernels and never read $INITRD,
# so searching /boot for them was pure noise: on an integrated-initramfs host
# it either warned about a missing initrd that no method needed, or embedded
# whatever stale initramfs-* file still sat in /boot.
# ---------------------------------------------------------------------------
case "$METHOD" in
    all|stub)
        if [[ -z "$INITRD" ]]; then
            INITRD=$(ls -t /boot/initramfs-* /boot/initrd-* 2>/dev/null | head -1 || true)
            if [[ -n "$INITRD" ]]; then
                warn "Auto-detected initrd: $INITRD"
            else
                warn "No initrd in /boot — built-in-initramfs kernels use stub-signed"
            fi
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# Build cmdline with root UUID
# ---------------------------------------------------------------------------
ROOT_UUID=""
if [[ -n "$ROOT_ARG" ]]; then
    # Explicit root for this entry — required when the kernel comes from
    # another disk's install (auto-detection would embed the RUNNING root).
    if [[ "$ROOT_ARG" == UUID=* ]]; then
        ROOT_UUID="${ROOT_ARG#UUID=}"
    else
        [[ -b "$ROOT_ARG" ]] || die "--root: not a block device: $ROOT_ARG"
        ROOT_UUID=$(blkid -o value -s UUID "$ROOT_ARG" 2>/dev/null || true)
        [[ -n "$ROOT_UUID" ]] || die "--root: no filesystem UUID on $ROOT_ARG"
    fi
else
    ROOT_PART=$(findmnt -n -o SOURCE / 2>/dev/null || true)
    if [[ -n "$ROOT_PART" ]]; then
        ROOT_UUID=$(blkid -o value -s UUID "$ROOT_PART" 2>/dev/null || true)
    fi
fi

if [[ -n "$ROOT_UUID" ]]; then
    CMDLINE="root=UUID=$ROOT_UUID $CMDLINE_EXTRA"
else
    warn "Root UUID not detected — falling back to ${DISK}p3, edit --cmdline"
    CMDLINE="root=${DISK}p3 $CMDLINE_EXTRA"
fi
info "cmdline: $CMDLINE"

# ---------------------------------------------------------------------------
# Early microcode images next to the kernel: intel-uc.img from
# sys-firmware/intel-microcode[initramfs], amd-uc.img from
# sys-kernel/linux-firmware[initramfs]. Microcode only takes effect when it
# reaches the kernel BEFORE boot — as the front of the initrd chain — because
# the bugs/mitigation decisions are made against the revision running at that
# moment; nothing scans /boot afterwards, and late loading is restricted.
# Each stub method therefore has to carry the images itself (grub/shim rely
# on the host's grub.cfg, where grub-mkconfig adds them on its own).
# ---------------------------------------------------------------------------
UCODE_IMGS=()
for _uc in "$(dirname "$KERNEL")"/intel-uc.img "$(dirname "$KERNEL")"/amd-uc.img; do
    if [[ -f "$_uc" ]]; then
        UCODE_IMGS+=("$_uc")
    fi
done
[[ ${#UCODE_IMGS[@]} -eq 0 ]] || info "early microcode: ${UCODE_IMGS[*]}"

# ---------------------------------------------------------------------------
# ESP check
# ---------------------------------------------------------------------------
# The kernel file is copied under $ESP (a MOUNT POINT), the NVRAM entry is
# registered on --disk/--part — two independent inputs that silently diverge:
# on 2026-08-10 '--disk /dev/sdd' with the default /boot/efi mounted from
# nvme0n1p1 put the signed kernel on the WRONG ESP, the entry kept pointing
# at sdd1's stale kernel, and the machine booted a kernel whose modules did
# not match. So the target partition, not the mount table, decides: if the
# --disk/--part partition is mounted somewhere, that path becomes $ESP; if
# not, it is mounted on a private temp dir for the duration of the run. An
# explicit --esp is validated against the same rule and refused on mismatch.
# NVMe-style disks (name ends in a digit) take a 'p' before the partition
# number. Do NOT fold the test into a command substitution inside the
# assignment: for /dev/sdd the [[ ]] is false, the substitution exits 1, the
# assignment inherits that status and set -e kills the script SILENTLY right
# here — "--disk /dev/sdd does nothing" (2026-08-14) was exactly this.
if [[ ${DISK} == *[0-9] ]]; then
    TARGET_PART="${DISK}p${PARTITION}"
else
    TARGET_PART="${DISK}${PARTITION}"
fi
[[ -b $TARGET_PART ]] || die "No such partition: $TARGET_PART (--disk $DISK --part $PARTITION)"
_esp_src=$(findmnt -rno SOURCE "$ESP" 2>/dev/null || true)
if [[ ${_esp_src} != "$TARGET_PART" ]]; then
    _part_mnt=$(findmnt -rno TARGET "$TARGET_PART" 2>/dev/null | head -1 || true)
    if [[ -n ${_esp_src} && ${ESP} != /boot/efi ]]; then
        # operator explicitly asked for a mount point that is NOT the target
        # partition — that is exactly the file/entry split this check exists
        # to prevent, so refuse rather than second-guess
        die "--esp $ESP is $_esp_src, but --disk/--part is $TARGET_PART — refusing to split file and entry"
    elif [[ -n ${_part_mnt} ]]; then
        info "ESP: $TARGET_PART is mounted at $_part_mnt (not $ESP) — using it"
        ESP="$_part_mnt"
    else
        ESP=$(mktemp -d /tmp/efi-boot-esp.XXXXXX)
        mount "$TARGET_PART" "$ESP" || die "Cannot mount $TARGET_PART"
        ESP_TMP_MOUNT="$ESP"
        trap '[[ -n ${ESP_TMP_MOUNT:-} ]] && { umount "$ESP_TMP_MOUNT" 2>/dev/null; rmdir "$ESP_TMP_MOUNT" 2>/dev/null; }' EXIT
        info "ESP: mounted $TARGET_PART at $ESP for this run"
    fi
fi
mountpoint -q "$ESP" || die "ESP not mounted at $ESP"

# ---------------------------------------------------------------------------
# Directory structure on ESP
# ---------------------------------------------------------------------------
# --name overrides only the stub directory and label; grub/shim/shell always
# use their fixed locations (one instance each makes sense per ESP), while
# several named stub entries can coexist for different disks' installs.
STUB_DIRNAME="${NAME:-GentooEFISTUB}"
STUB_SUFFIX="${NAME:+ ($NAME)}"

EFIDIR_GRUB="$ESP/EFI/Gentoo"
EFIDIR_SHIM="$ESP/EFI/GentooShim"
EFIDIR_STUB="$ESP/EFI/$STUB_DIRNAME"

# FAT32 is case-insensitive — if a case variant of the directory already
# exists, reuse it to avoid mixed-case duplicates on the ESP.
# $ESP/EFI may not exist yet (fresh ESP) — find on a missing path returns
# nonzero and with pipefail would kill the script, hence the guard and || true.
if [[ -d "$ESP/EFI" ]]; then
    for _target in Gentoo GentooShim "$STUB_DIRNAME"; do
        _dir="$ESP/EFI/$_target"
        [[ -d "$_dir" ]] && continue
        _existing=$(find "$ESP/EFI" -maxdepth 1 -iname "$_target" -type d 2>/dev/null | head -1) || true
        if [[ -n "$_existing" ]]; then
            case "$_target" in
                Gentoo)          EFIDIR_GRUB="$_existing" ;;
                GentooShim)      EFIDIR_SHIM="$_existing" ;;
                "$STUB_DIRNAME") EFIDIR_STUB="$_existing" ;;
            esac
        fi
    done
fi

# Keep the loader path spelling in sync with whatever directory was reused
STUB_DIRNAME=$(basename "$EFIDIR_STUB")

mkdir -p "$EFIDIR_GRUB" "$EFIDIR_SHIM" "$EFIDIR_STUB"
mkdir -p "$WORKDIR/grub" "$WORKDIR/shim-grub" "$WORKDIR/efistub"

# ---------------------------------------------------------------------------
# Helper: remove duplicate efibootmgr entry by label
# ---------------------------------------------------------------------------
remove_efi_entry() {
    local label="$1" bootnum
    # Exact-label match — a substring grep on "Gentoo EFI Stub" would also
    # sweep up "Gentoo EFI Stub LUKS" and every named "(...)" variant.
    # Modern efibootmgr prints the device path after the label even WITHOUT
    # -v, separated by a tab — comparing the whole rest of the line against
    # the label matched nothing and every re-run stacked a duplicate entry
    # (caught 2026-08-14), so strip from the first tab before comparing.
    while read -r bootnum; do
        [[ -n "$bootnum" ]] || continue
        info "  Removing old entry Boot$bootnum ($label)"
        efibootmgr -b "$bootnum" -B >/dev/null 2>&1 || true
    done < <(efibootmgr | awk -v l="$label" \
        '/^Boot[0-9A-F][0-9A-F][0-9A-F][0-9A-F]/ {
             s = $0
             sub(/^Boot[0-9A-F][0-9A-F][0-9A-F][0-9A-F]\*? /, "", s)
             sub(/\t.*/, "", s)
             if (s == l) print substr($0, 5, 4)
         }')
}

# ---------------------------------------------------------------------------
# Helper: copy the microcode images into the stub dir and print the
# "initrd=\..." cmdline prefix that makes the kernel's EFI stub load them.
# The stub concatenates multiple initrd= files in the order given, so the
# prefix goes BEFORE the rest of the cmdline and the microcode cpios end up
# at the front of the blob, where the early loader looks for them.
# ---------------------------------------------------------------------------
stub_ucode_cmdline() {
    local uc pre=""
    for uc in "${UCODE_IMGS[@]}"; do
        cp -f "$uc" "$EFIDIR_STUB/" || die "cp $uc -> $EFIDIR_STUB failed"
        pre+="initrd=\\EFI\\${STUB_DIRNAME}\\$(basename "$uc") "
    done
    printf '%s' "$pre"
}

# ---------------------------------------------------------------------------
# Method: GRUB standalone signed with db key                          [rank 2]
# Requires own PK/KEK/db enrolled in UEFI.
# GRUB code executes before kernel — slightly larger attack surface than stub.
# grub.cfg changes require rebuild and re-sign.
# ---------------------------------------------------------------------------
setup_grub_signed() {
    info "METHOD: GRUB standalone (signed with db key)..."

    grub-mkstandalone \
        --directory=/usr/lib/grub/x86_64-efi \
        --format=x86_64-efi \
        --output="$WORKDIR/grub/grubx64.efi" \
        --modules="$GRUB_MODULES_FULL" \
        --locales="" \
        --fonts="" \
        "boot/grub/grub.cfg=/boot/grub/grub.cfg"

    sbsign \
        --key "$KEYDIR/db.key" \
        --cert "$KEYDIR/db.crt" \
        --output "$EFIDIR_GRUB/grubx64.efi" \
        "$WORKDIR/grub/grubx64.efi"

    sbverify --list "$EFIDIR_GRUB/grubx64.efi"

    remove_efi_entry "Gentoo Secure Boot (GRUB)"
    efibootmgr --create \
        --disk "$DISK" --part "$PARTITION" \
        --label "Gentoo Secure Boot (GRUB)" \
        --loader '\EFI\Gentoo\grubx64.efi'

    ok "GRUB signed → $EFIDIR_GRUB/grubx64.efi"
}

# ---------------------------------------------------------------------------
# Method: GRUB + shim (MOK-signed GRUB)                              [rank 3]
# Does NOT require own PK — uses Microsoft-signed shim as trust anchor.
# Safe for dual-boot: PK/KEK untouched, MOK managed via mokutil from OS.
# Weakness: trust chain goes through MS infrastructure and shim binary.
# After install: mokutil --import MOK.der, then confirm in MokManager on reboot.
# ---------------------------------------------------------------------------
setup_shim() {
    info "METHOD: GRUB + shim (MOK)..."

    grub-mkstandalone \
        --directory=/usr/lib/grub/x86_64-efi \
        --format=x86_64-efi \
        --output="$WORKDIR/shim-grub/grubx64.efi" \
        --modules="$GRUB_MODULES_SHIM" \
        --locales="" \
        --fonts="" \
        "boot/grub/grub.cfg=/boot/grub/grub.cfg"

    sbsign \
        --key "$KEYDIR/MOK.key" \
        --cert "$KEYDIR/MOK.crt" \
        --output "$EFIDIR_SHIM/grubx64.efi" \
        "$WORKDIR/shim-grub/grubx64.efi"

    sbverify --list "$EFIDIR_SHIM/grubx64.efi"

    cp /usr/share/shim/BOOTX64.EFI "$EFIDIR_SHIM/shimx64.efi"
    cp /usr/share/shim/mmx64.efi   "$EFIDIR_SHIM/"
    cp "$KEYDIR/MOK.der"           "$EFIDIR_SHIM/"

    remove_efi_entry "Gentoo Shim Boot"
    efibootmgr --create \
        --disk "$DISK" --part "$PARTITION" \
        --label "Gentoo Shim Boot" \
        --loader '\EFI\GentooShim\shimx64.efi'

    echo ""
    echo "  ════════════════════════════════════════════════════════"
    echo "  ACTION REQUIRED — MOK enrollment:"
    echo "    mokutil --import $EFIDIR_SHIM/MOK.der"
    echo "  On the next reboot shim will open MokManager."
    echo "  ════════════════════════════════════════════════════════"

    ok "Shim → $EFIDIR_SHIM/shimx64.efi"
}

# ---------------------------------------------------------------------------
# Method: UKI — kernel + initrd + cmdline in one signed PE           [rank 1]
# Requires own PK/KEK/db enrolled in UEFI, and systemd-stub on the build
# host (sys-apps/systemd or systemd-utils with USE=boot; ukify if USE=ukify).
#
# WHY systemd-stub is not optional: the .cmdline/.initrd/.linux PE sections
# are read by systemd-stub, NOT by the kernel. The kernel's own EFI stub
# (drivers/firmware/efi/libstub/) takes its cmdline from EFI LoadOptions and
# an initrd only via "initrd=" file lookup or LINUX_EFI_INITRD_MEDIA_GUID —
# it never parses PE sections. The previous objcopy-onto-the-bzImage code
# produced a kernel that booted with an EMPTY cmdline and no initrd while
# looking perfectly healthy (found 2026-08-14). Also: the fixed VMAs it used
# collided with the kernel image (.cmdline=0x20000 sat inside .text), and
# the process-substitution cmdline stat'ed as 0 bytes. A UKI puts the KERNEL
# into a .linux section of the small stub binary, which is why the classic
# offsets work there.
# ---------------------------------------------------------------------------
setup_efistub_full() {
    info "METHOD: UKI (systemd-stub: kernel + initrd + cmdline, one signed PE)..."

    [[ -n "$INITRD" && -f "$INITRD" ]] \
        || die "No initrd — use --initrd or --method stub-signed for kernel with built-in initramfs"

    # Early-microcode format: the uncompressed vendor cpio(s) glued in FRONT
    # of the real initramfs, in one blob — the kernel peels them off before
    # unpacking the rest. A UKI has a single .initrd section, so the gluing
    # happens here rather than via a second initrd= entry.
    local UKI_INITRD="$INITRD"
    if [[ ${#UCODE_IMGS[@]} -gt 0 ]]; then
        cat "${UCODE_IMGS[@]}" "$INITRD" > "$WORKDIR/efistub/initrd-with-ucode.img" \
            || die "microcode+initrd concatenation failed"
        UKI_INITRD="$WORKDIR/efistub/initrd-with-ucode.img"
        info "UKI initrd: microcode prepended (${UCODE_IMGS[*]})"
    fi

    local SD_STUB=""
    for _s in /usr/lib/systemd/boot/efi/linuxx64.efi.stub \
              /usr/lib/systemd-boot/linuxx64.efi.stub; do
        [[ -f "$_s" ]] && { SD_STUB="$_s"; break; }
    done

    if command -v ukify &>/dev/null; then
        # ukify computes section offsets correctly for any kernel/initrd size
        ukify build \
            --linux "$KERNEL" \
            --initrd "$UKI_INITRD" \
            --cmdline "$CMDLINE" \
            --output "$WORKDIR/efistub/vmlinuz-efistub.efi" \
            || die "ukify build failed"
    elif [[ -n "$SD_STUB" ]]; then
        # Manual UKI: sections appended to the STUB, offsets computed from the
        # previous section's end (fixed offsets break once the kernel > 32 MB).
        local _cmdfile="$WORKDIR/efistub/cmdline.txt"
        printf '%s' "$CMDLINE" > "$_cmdfile"
        local _off _align=0x10000
        _off=$(objdump -h "$SD_STUB" | awk '/^ *[0-9]+ /{ o=strtonum("0x"$4)+strtonum("0x"$3); if(o>m) m=o } END{ printf "%d", m }')
        _next_vma() {  # align past the previous section end, then advance
            _off=$(( (_off + _align - 1) / _align * _align ))
            printf '0x%x' "$_off"
            _off=$(( _off + $(stat -c %s "$1") ))
        }
        local _v_cmd _v_linux _v_initrd
        _v_cmd=$(_next_vma "$_cmdfile")
        _v_linux=$(_next_vma "$KERNEL")
        _v_initrd=$(_next_vma "$UKI_INITRD")
        objcopy \
            --add-section .cmdline="$_cmdfile"   --change-section-vma .cmdline="$_v_cmd" \
            --add-section .linux="$KERNEL"       --change-section-vma .linux="$_v_linux" \
            --add-section .initrd="$UKI_INITRD"  --change-section-vma .initrd="$_v_initrd" \
            "$SD_STUB" \
            "$WORKDIR/efistub/vmlinuz-efistub.efi"
    else
        die "No systemd-stub on this host — the kernel's EFI stub does not read \
.cmdline/.initrd PE sections, so an embedded-initrd image REQUIRES it. Install \
sys-apps/systemd with USE=\"boot ukify\" (or systemd-utils[boot]), or use \
--method stub-signed (built-in initramfs)."
    fi

    # Own filename — stub-signed writes vmlinuz-signed.efi into the same dir,
    # and under --method all it used to overwrite this method's output while
    # the "initrd embedded" NVRAM entry kept pointing at the clobbered file.
    sbsign \
        --key "$KEYDIR/db.key" \
        --cert "$KEYDIR/db.crt" \
        --output "$EFIDIR_STUB/vmlinuz-uki.efi" \
        "$WORKDIR/efistub/vmlinuz-efistub.efi"

    sbverify --list "$EFIDIR_STUB/vmlinuz-uki.efi"

    remove_efi_entry "Gentoo EFI Stub (initrd embedded)${STUB_SUFFIX}"
    efibootmgr --create \
        --disk "$DISK" --part "$PARTITION" \
        --label "Gentoo EFI Stub (initrd embedded)${STUB_SUFFIX}" \
        --loader "\\EFI\\${STUB_DIRNAME}\\vmlinuz-uki.efi"

    ok "UKI → $EFIDIR_STUB/vmlinuz-uki.efi"
}

# ---------------------------------------------------------------------------
# Method: EFI Stub signed only (built-in initramfs)     [rank 1, CONFIRMED]
# Requires own PK/KEK/db enrolled in UEFI.
# Kernel compiled with CONFIG_INITRAMFS_SOURCE — no external initrd needed.
# Simplest and most reliable stub variant: sign + efibootmgr only, no objcopy.
# cmdline passed via efibootmgr --unicode (stored in NVRAM, not in EFI file).
# After kernel update: re-run this method only — no grub.cfg rebuild needed.
# ---------------------------------------------------------------------------
setup_efistub_signed() {
    info "METHOD: EFI Stub signed only (kernel with built-in initramfs)..."

    # Kernel compiled with CONFIG_INITRAMFS_SOURCE pointing to pre-built initramfs.
    # No external initrd needed — cmdline passed via efibootmgr --unicode.
    sbsign \
        --key "$KEYDIR/db.key" \
        --cert "$KEYDIR/db.crt" \
        --output "$EFIDIR_STUB/vmlinuz-signed.efi" \
        "$KERNEL"

    sbverify --list "$EFIDIR_STUB/vmlinuz-signed.efi"

    local _uc_pre
    _uc_pre=$(stub_ucode_cmdline)

    remove_efi_entry "Gentoo EFI Stub${STUB_SUFFIX}"
    efibootmgr --create \
        --disk "$DISK" --part "$PARTITION" \
        --label "Gentoo EFI Stub${STUB_SUFFIX}" \
        --loader "\\EFI\\${STUB_DIRNAME}\\vmlinuz-signed.efi" \
        --unicode "${_uc_pre}${CMDLINE}"

    ok "EFI Stub signed → $EFIDIR_STUB/vmlinuz-signed.efi"
}

# ---------------------------------------------------------------------------
# Method: EFI Stub signed only + LUKS2 cmdline                       [rank 1]
# Identical to stub-signed but cmdline includes rd.luks.uuid for LUKS2 root.
# Kernel built with CONFIG_CMDLINE (base) without OVERRIDE — efibootmgr
# --unicode appends to kernel's built-in cmdline, so rd.luks.uuid is added
# on top of CONFIG_CMDLINE without modifying the kernel binary.
# Requires genkernel built with --luks (cryptsetup in initramfs).
# ---------------------------------------------------------------------------
setup_efistub_luks() {
    info "METHOD: EFI Stub signed + LUKS2..."

    if [[ -z "$LUKS_UUID" ]]; then
        # Auto-detect from currently open LUKS devices
        local _raw
        _raw=$(dmsetup info -c --noheadings -o uuid 2>/dev/null | head -1 \
            | sed 's/^CRYPT-LUKS2-//' | sed 's/-[^-]*$//' || true)
        if [[ -z "$_raw" ]]; then
            die "Provide LUKS UUID via --luks-uuid UUID or open container: cryptsetup luksOpen /dev/... root"
        fi
        # dmsetup strips dashes — reformat to xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
        LUKS_UUID=$(echo "$_raw" | sed \
            's/\([0-9a-f]\{8\}\)\([0-9a-f]\{4\}\)\([0-9a-f]\{4\}\)\([0-9a-f]\{4\}\)\([0-9a-f]\{12\}\)/\1-\2-\3-\4-\5/')
        warn "Auto-detected LUKS UUID: $LUKS_UUID"
    fi

    # Build cmdline: kernel CONFIG_CMDLINE is base, efibootmgr --unicode appends
    # rd.luks.uuid tells dracut/genkernel initramfs which device to unlock.
    # genkernel's initrd.scripts hardcodes the mapper name to "root" for
    # crypt_root (openLUKS "root" / REAL_ROOT="/dev/mapper/root" in
    # start_LUKS_root() — verified against the installed genkernel package,
    # not configurable via crypttab or crypt_root_options). root= MUST say
    # /dev/mapper/root or genkernel unlocks the container successfully and
    # then reports "Could not find the root block device" because it's
    # looking for a different mapper name than the one it just created.
    local LUKS_CMDLINE="crypt_root=UUID=$LUKS_UUID root=/dev/mapper/root $CMDLINE_EXTRA"
    info "LUKS cmdline (appended to CONFIG_CMDLINE): $LUKS_CMDLINE"

    sbsign \
        --key "$KEYDIR/db.key" \
        --cert "$KEYDIR/db.crt" \
        --output "$EFIDIR_STUB/vmlinuz-signed-luks.efi" \
        "$KERNEL"

    sbverify --list "$EFIDIR_STUB/vmlinuz-signed-luks.efi"

    local _uc_pre
    _uc_pre=$(stub_ucode_cmdline)

    remove_efi_entry "Gentoo EFI Stub LUKS${STUB_SUFFIX}"
    efibootmgr --create \
        --disk "$DISK" --part "$PARTITION" \
        --label "Gentoo EFI Stub LUKS${STUB_SUFFIX}" \
        --loader "\\EFI\\${STUB_DIRNAME}\\vmlinuz-signed-luks.efi" \
        --unicode "${_uc_pre}${LUKS_CMDLINE}"

    ok "EFI Stub LUKS → $EFIDIR_STUB/vmlinuz-signed-luks.efi"
    echo ""
    echo "  LUKS UUID in NVRAM: $LUKS_UUID"
    echo "  Full cmdline:       $(efibootmgr -v | grep 'Gentoo EFI Stub LUKS' | sed -E 's/.*\.efi//' | xxd -r -p|| true)"
    echo ""
    echo "  Requirements:"
    echo "  - genkernel built with --luks: genkernel --luks initramfs"
    echo "  - genkernel always names the unlocked root mapper /dev/mapper/root"
    echo "    (hardcoded in initrd.scripts' start_LUKS_root, not configurable)"
}
setup_efi_shell() {
    info "METHOD: EFI Shell..."

    local SHELL_DIR="$ESP/EFI/Shell"
    mkdir -p "$SHELL_DIR"

    if [[ ! -f "$SHELL_DIR/shellx64.efi" ]]; then
        warn "Missing $SHELL_DIR/shellx64.efi"
        echo "  Download:"
        echo "  wget -O $SHELL_DIR/shellx64.efi \\"
        echo "    https://github.com/tianocore/edk2/raw/edk2-stable202302/ShellBinPkg/UefiShell/X64/Shell.efi"
        return
    fi

    remove_efi_entry "EFI Shell"
    efibootmgr --create \
        --disk "$DISK" --part "$PARTITION" \
        --label "EFI Shell" \
        --loader '\EFI\Shell\shellx64.efi'

    ok "EFI Shell → $SHELL_DIR/shellx64.efi"
}

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
print_summary() {
    echo ""
    echo "════════════════════════════════════════════════════════════"
    echo "  UEFI boot entries:"
    efibootmgr -v | grep -E "Boot[0-9A-F]{4}" || true
    echo ""
    echo "  ESP/EFI structure:"
    find "$ESP/EFI" -maxdepth 2 -type f | sort | sed "s|$ESP||"
    echo "════════════════════════════════════════════════════════════"
    echo ""
    echo "After kernel update re-run (same --disk/--name as the install):"
    echo "  sudo efi-boot --disk $DISK --method stub-signed"
    echo ""
    echo "If Windows overwrites EFI/Boot/bootx64.efi:"
    echo "  cp $ESP/EFI/Microsoft/Boot/bootmgfw.efi $ESP/EFI/Boot/bootx64.efi"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
echo ""
echo "════════════════════════════════════════════════════════════"
echo "  efi-boot — Gentoo UEFI boot installer"
echo "  Disk: $DISK  ESP partition: $PARTITION  Method: $METHOD"
echo "  Kernel: $KERNEL"
echo "  Initrd: ${INITRD:-<none>}"
echo "  Cmdline: $CMDLINE"
echo "════════════════════════════════════════════════════════════"
echo ""

case "$METHOD" in
    all)
        setup_grub_signed
        setup_shim
        if [[ -z "$INITRD" || ! -f "$INITRD" ]]; then
            warn "Skipping UKI (stub) — no initrd"
        elif ! command -v ukify &>/dev/null \
             && [[ ! -f /usr/lib/systemd/boot/efi/linuxx64.efi.stub ]] \
             && [[ ! -f /usr/lib/systemd-boot/linuxx64.efi.stub ]]; then
            # setup_efistub_full would die here and abort the remaining
            # methods — under 'all' the UKI is optional, so skip instead
            warn "Skipping UKI (stub) — no systemd-stub/ukify on this host"
        else
            setup_efistub_full
        fi
        setup_efistub_signed
        setup_efi_shell
        ;;
    grub)        setup_grub_signed ;;
    shim)        setup_shim ;;
    stub)        setup_efistub_full ;;
    stub-signed) setup_efistub_signed ;;
    stub-luks)   setup_efistub_luks ;;
    shell)       setup_efi_shell ;;
    *) die "Unknown method: $METHOD. Available: all grub shim stub stub-signed stub-luks shell"
esac

print_summary
