#!/bin/bash
set -euo pipefail

help() {
  cat << EOF
Compile LaTeX to PDF
Usage: tex2pdf [-m <mode>] <file.tex|file.Rnw|basename>

Modes (-m):
  pdflatex  (default): pdflatex → evince
  latex:    latex + bibtex + dvips + ps2pdf → evince
  sweave:   R Sweave + pdflatex + bibtex → evince
  gtx:      latex + dvips → gv (ghostview)
  lualatex: lualatex + asy + lualatex → qpdfview  (--shell-escape: the .tex
            can run commands as you - only for documents you trust)

The build runs in the directory of the input file. bibtex runs only when the
.aux file has \\citation/\\bibdata entries. Any failed step stops the script,
so a stale PDF is never opened as if it were fresh.

Examples:
  tex2pdf thesis.tex
  tex2pdf thesis             (works without extension too)
  tex2pdf -m latex thesis.tex
  tex2pdf -m sweave analysis.Rnw
  tex2pdf -m lualatex presentation.tex
  tex2pdf -m gtx slides.tex
EOF
}

die() { echo "tex2pdf: $*" >&2; exit 1; }

case "${1:-}" in
  -h|--help) help; exit 0 ;;
  "")        help; exit 1 ;;
esac

MODE="pdflatex"
if [[ $1 == -m ]]; then
  [[ -n ${2:-} ]] || { help >&2; die "no mode specified after -m"; }
  MODE=$2
  shift 2
fi
case $MODE in
  pdflatex|latex|sweave|gtx|lualatex) ;;
  *) help >&2; die "unknown mode '$MODE'" ;;
esac

[[ $# -gt 0 ]] || { help >&2; die "provide a .tex file"; }
FILE=$1

# Strip the extension but keep the directory, then build inside it
j=${FILE%.tex}
j=${j%.Rnw}
DIR=$(dirname -- "$j")
j=$(basename -- "$j")
cd -- "$DIR" || die "cannot cd to $DIR"
if [[ $MODE == sweave ]]; then
  [[ -f ${j}.Rnw ]] || die "not found: $DIR/${j}.Rnw"
else
  [[ -f ${j}.tex ]] || die "not found: $DIR/${j}.tex"
fi

run() { "$@" || die "$1 failed (see ${j}.log)"; }

# bibtex exits 1 for a document without citations - run it only when needed
maybe_bibtex() {
  if grep -qs -e '\\citation' -e '\\bibdata' "${j}.aux"; then
    run bibtex "$j"
  fi
}

need_pdf() { [[ -s ${j}.pdf ]] || die "no PDF produced: ${j}.pdf"; }

case $MODE in
  pdflatex)
    run pdflatex "${j}.tex"
    need_pdf
    evince "${j}.pdf"
    ;;
  latex)
    run latex "${j}.tex"
    maybe_bibtex
    run latex "${j}.tex"
    run latex "${j}.tex"
    run dvips "${j}.dvi" -o "${j}.ps"
    run ps2pdf -sPAPERSIZE=a4 "${j}.ps" "${j}.pdf"
    need_pdf
    evince "${j}.pdf"
    ;;
  sweave)
    run R CMD Sweave "${j}.Rnw"
    run pdflatex "${j}.tex"
    maybe_bibtex
    run pdflatex "${j}.tex"
    run pdflatex "${j}.tex"
    need_pdf
    evince "${j}.pdf"
    ;;
  gtx)
    run latex "${j}.tex"
    run dvips "${j}.dvi" -o "${j}.ps"
    gv "${j}.ps"
    ;;
  lualatex)
    run lualatex --shell-escape "${j}.tex"
    shopt -s nullglob
    asyfiles=("${j}"*.asy)
    shopt -u nullglob
    if [[ ${#asyfiles[@]} -gt 0 ]]; then
      run asy --tex lualatex "${asyfiles[@]}"
    fi
    run lualatex --shell-escape "${j}.tex"
    need_pdf
    qpdfview "${j}.pdf"
    ;;
esac
